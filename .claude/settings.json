{
  "env": {
    "ANTHROPIC_BASE_URL": "https://api.nextgen-beta.ica.ibm.com/ica",
    "ANTHROPIC_AUTH_TOKEN": "***TOKEN-REVOKED***",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4-5",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },
  "theme": "auto",
  "contextManagement": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(graphify query *)",
      "Bash(graphify explain *)",
      "Bash(graphify path *)",
      "Bash(.claude/scripts/issues.sh list)",
      "Bash(.claude/scripts/issues.sh view *)",
      "Bash(.claude/scripts/pr.sh status)"
    ]
  }
}